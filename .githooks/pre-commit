#!/usr/bin/env bash
# Self-validation before every commit:
# - ktlint + unit tests when the JetBrains plugin (intellij/) or the shared format spec (spec/) is staged;
# - type-check + tests when the VS Code extension (vscode/) or the spec is staged.
# Enable with:  make hooks  (sets core.hooksPath=.githooks).
# Bypass in an emergency with:  git commit --no-verify
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel)"
staged="$(git diff --cached --name-only --diff-filter=ACMR)"

if echo "$staged" | grep -qE '^intellij/.*\.(kt|kts|toml|properties)$|^intellij/src/main/resources/|^spec/'; then
  cd "$ROOT/intellij" || exit 1
  echo "▶ ktlint"
  if ! ./gradlew --quiet --console=plain ktlintCheck; then
    echo "  → run 'make format' to fix formatting" >&2
    exit 1
  fi
  echo "▶ unit tests"
  if ! ./gradlew --quiet --console=plain test; then
    exit 1
  fi
fi

if echo "$staged" | grep -qE '^vscode/|^spec/'; then
  cd "$ROOT/vscode" || exit 1
  if [ ! -d node_modules ]; then npm ci --silent || exit 1; fi
  echo "▶ VS Code: type-check + tests"
  if ! npm run --silent check > /dev/null; then
    npm run --silent check | grep -E '^not ok|error TS' >&2
    exit 1
  fi
fi
