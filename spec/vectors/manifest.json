    {
      "name": "paths-normalized",
      "description": "Backslashes become /, and empty and . segments are dropped.",
      "file": "paths-normalized.txt",
      "passphrase": null,
      "expect": {
        "files": [
          {
            "path": "dir/file.txt",
            "content": "YQ==",
            "mode": null,
            "executable": false
          },
          {
            "path": "dir2/x.txt",
            "content": "Yg==",
            "mode": null,
            "executable": false
          }
        ]
      }
    },
    {
      "name": "duplicate-after-normalization",
      "description": "Two entries that name the same file.",
      "file": "duplicate-after-normalization.txt",
      "passphrase": null,
      "expect": {
        "error": "INVALID_ARCHIVE"
      }
    },
    {
      "name": "directory-entries-ignored",
      "description": "Directory entries carry no content and are skipped.",
      "file": "directory-entries-ignored.txt",
      "passphrase": null,
      "expect": {
        "files": [
          {
            "path": "d/f.txt",
            "content": "Zg==",
            "mode": null,
            "executable": false
          }
        ]
      }
    },
    {
      "name": "zip-bomb-size",
      "description": "One entry that inflates past the 200 MB decode limit (about 200 KB compressed).",
      "file": "zip-bomb-size.txt",
      "passphrase": null,
      "expect": {
        "error": "INVALID_ARCHIVE"
      }
    },
    {
      "name": "vcs-metadata-blocked",
      "description": "Decodes, but a paste must never write into VCS metadata such as .git/hooks.",
      "file": "vcs-metadata-blocked.txt",
      "passphrase": null,
      "expect": {
        "files": [
          {
            "path": "p/.git/hooks/pre-commit",
            "content": "IyEvYmluL3NoCg==",
            "mode": "0755",
            "executable": true
          },
          {
            "path": "p/ok.txt",
            "content": "b2sK",
            "mode": "0644",
            "executable": false
          }
        ],
        "blocked": [
          "p/.git/hooks/pre-commit"
        ]
      }
    },
    {
      "name": "case-clash-blocked",
      "description": "Decodes, but on a case-insensitive target the second of two case-variant names is blocked.",
      "file": "case-clash-blocked.txt",
      "passphrase": null,
      "expect": {
        "files": [
          {
            "path": "p/Readme.md",
            "content": "YQ==",
            "mode": null,
            "executable": false
          },
          {
            "path": "p/README.md",
            "content": "Yg==",
            "mode": null,
            "executable": false
          }
        ],
        "blocked": [
          "p/README.md"
        ]
      }
    },
    {
      "name": "file-folder-clash-blocked",
      "description": "Decodes, but a file can't sit where another entry needs a folder.",
      "file": "file-folder-clash-blocked.txt",
      "passphrase": null,
      "expect": {
        "files": [
          {
            "path": "p/x",
            "content": "ZmlsZQ==",
            "mode": null,
            "executable": false
          },
          {
            "path": "p/x/y.txt",
            "content": "aW5uZXI=",
            "mode": null,
            "executable": false
          }
        ],
        "blocked": [
          "p/x"
        ]
      }
    },
    {
      "name": "nbsp-before-begin",
      "description": "A no-break space (U+00A0) between the dashes and BEGIN: \\s means ASCII whitespace only, so no marker.",
      "file": "nbsp-before-begin.txt",
      "passphrase": null,
      "expect": {
        "error": "NOT_FOUND"
      }
    },
    {
      "name": "base64-unpadded",
      "description": "Base64 without its = padding still decodes; the declared length counts the characters actually sent.",
      "file": "base64-unpadded.txt",
      "passphrase": null,
      "expect": {
        "files": [
          {
            "path": "pad.txt",
            "content": "cHBw",
            "mode": null,
            "executable": false
          }
        ]
      }
    },
    {
      "name": "base64-nonzero-trailing-bits",
      "description": "Unused low bits in the last Base64 character are set (like QR== for QQ==): they are ignored.",
      "file": "base64-nonzero-trailing-bits.txt",
      "passphrase": null,
      "expect": {
        "files": [
          {
            "path": "pad.txt",
            "content": "cHBw",
            "mode": null,
            "executable": false
          }
        ]
      }
    },
    {
      "name": "begin-end-adjacent",
