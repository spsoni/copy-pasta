{
  "format": 2,
  "spec": "../FORMAT.md",
  "cases": [
    {
      "name": "plain-project",
      "description": "A plain envelope with text, binary, empty, executable, private and non-ASCII files.",
      "file": "plain-project.txt",
      "passphrase": null,
      "expect": {
        "files": [
          {
            "path": "demo/README.md",
            "content": "IyBEZW1vCg==",
            "mode": "0644",
            "executable": false
          },
          {
            "path": "demo/src/main.kt",
            "content": "ZnVuIG1haW4oKSA9IHByaW50bG4oImhpIikK",
            "mode": "0644",
            "executable": false
          },
          {
            "path": "demo/run.sh",
            "content": "IyEvYmluL3NoCmVjaG8gaGkK",
            "mode": "0755",
            "executable": true
          },
          {
            "path": "demo/secret.pem",
            "content": "cHJpdmF0ZSBrZXkgbWF0ZXJpYWwK",
            "mode": "0600",
            "executable": false
          },
          {
            "path": "demo/empty.txt",
            "content": "",
            "mode": "0644",
            "executable": false
          },
          {
            "path": "demo/bin.dat",
            "content": "",
            "mode": "0644",
            "executable": false
          },
          {
            "path": "demo/unicodé/naïve.txt",
            "content": "R3LDvMOfZSwg5LiW55WMCg==",
            "mode": "0644",
            "executable": false
          }
        ],
        "encrypted": false,
        "summary": "7 files, 1 KB"
      }
    },
    {
      "name": "encrypted-project",
      "description": "The same tree, encrypted with 600,000 PBKDF2 iterations (the current default).",
      "file": "encrypted-project.txt",
      "passphrase": "correct horse battery staple",
      "expect": {
        "files": [
          {
            "path": "demo/README.md",
            "content": "IyBEZW1vCg==",
            "mode": "0644",
            "executable": false
          },
          {
            "path": "demo/src/main.kt",
            "content": "ZnVuIG1haW4oKSA9IHByaW50bG4oImhpIikK",
            "mode": "0644",
            "executable": false
          },
          {
            "path": "demo/run.sh",
            "content": "IyEvYmluL3NoCmVjaG8gaGkK",
            "mode": "0755",
            "executable": true
          },
          {
            "path": "demo/secret.pem",
            "content": "cHJpdmF0ZSBrZXkgbWF0ZXJpYWwK",
            "mode": "0600",
            "executable": false
          },
          {
            "path": "demo/empty.txt",
            "content": "",
            "mode": "0644",
            "executable": false
          },
          {
            "path": "demo/bin.dat",
            "content": "",
            "mode": "0644",
            "executable": false
          },
          {
            "path": "demo/unicodé/naïve.txt",
            "content": "R3LDvMOfZSwg5LiW55WMCg==",
            "mode": "0644",
            "executable": false
          }
        ],
        "encrypted": true,
        "summary": "7 files, 1 KB"
      }
    },
    {
      "name": "encrypted-one-iteration",
      "description": "Readers take the iteration count from the payload (any value from 1 to 5,000,000), never a constant.",
      "file": "encrypted-one-iteration.txt",
      "passphrase": "pw",
      "expect": {
        "files": [
          {
            "path": "hello/hello.txt",
            "content": "SGVsbG8sIHdvcmxkIQo=",
            "mode": "0644",
            "executable": false
          },
          {
            "path": "hello/run.sh",
            "content": "IyEvYmluL3NoCmVjaG8gaGVsbG8K",
            "mode": "0755",
            "executable": true
          }
        ],
        "encrypted": true
      }
    },
    {
      "name": "encrypted-wrong-passphrase",
      "description": "GCM authentication fails, so the error is a wrong passphrase, never garbage output.",
      "file": "encrypted-wrong-passphrase.txt",
      "passphrase": "wrong",
      "expect": {
        "error": "WRONG_PASSPHRASE"
      }
    },
    {
      "name": "encrypted-iterations-over-cap",
      "description": "An iteration count above 5,000,000 is rejected before any key derivation runs.",
      "file": "encrypted-iterations-over-cap.txt",
      "passphrase": "x",
      "expect": {
        "error": "INVALID_ARCHIVE"
      }
    },
    {
      "name": "encrypted-label-plain-payload",
      "description": "An ENCRYPTED label whose body doesn't start with CPv2.",
      "file": "encrypted-label-plain-payload.txt",
      "passphrase": "x",
      "expect": {
        "error": "INVALID_ARCHIVE"
      }
    },
    {
      "name": "legacy-2.0-exec-flag",
      "description": "Copy-Pasta 2.0 wrote a one-byte 0x4350 field, only for executable files: executable, mode unknown.",
      "file": "legacy-2.0-exec-flag.txt",
      "passphrase": null,
      "expect": {
        "files": [
          {
            "path": "tool.sh",
            "content": "IyEvYmluL3NoCg==",
            "mode": null,
            "executable": true
          },
          {
            "path": "notes.txt",
            "content": "bgo=",
            "mode": null,
            "executable": false
          }
        ]
      }
    },
    {
      "name": "extra-field-forward-compat",
      "description": "Another extra field before 0x4350, and a 0x4350 field longer than 3 bytes (future appended data).",
      "file": "extra-field-forward-compat.txt",
      "passphrase": null,
      "expect": {
        "files": [
          {
            "path": "future.sh",
            "content": "IyEvYmluL3NoCg==",
            "mode": "0755",
            "executable": true
          }
        ]
      }
    },
    {
