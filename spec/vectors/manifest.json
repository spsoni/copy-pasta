    {
      "name": "truncated-no-end",
      "description": "Cut off in the middle: no END marker.",
      "file": "truncated-no-end.txt",
      "passphrase": null,
      "expect": {
        "error": "INCOMPLETE"
      }
    },
    {
      "name": "truncated-with-end",
      "description": "Body lines lost but the END marker survived: shorter than the declared length.",
      "file": "truncated-with-end.txt",
      "passphrase": null,
      "expect": {
        "error": "INCOMPLETE"
      }
    },
    {
      "name": "body-longer-than-length",
      "description": "More Base64 than the declared length.",
      "file": "body-longer-than-length.txt",
      "passphrase": null,
      "expect": {
        "error": "CORRUPTED"
      }
    },
    {
      "name": "corrupted-base64",
      "description": "A character that isn't Base64, at the declared length.",
      "file": "corrupted-base64.txt",
      "passphrase": null,
      "expect": {
        "error": "CORRUPTED"
      }
    },
    {
      "name": "newer-format",
      "description": "Format 3 is from a newer version: readers ask the user to update.",
      "file": "newer-format.txt",
      "passphrase": null,
      "expect": {
        "error": "NEWER_VERSION"
      }
    },
    {
      "name": "not-found",
      "description": "Ordinary chat text.",
      "file": "not-found.txt",
      "passphrase": null,
      "expect": {
        "error": "NOT_FOUND"
      }
    },
    {
      "name": "dash-flood",
      "description": "64k dashes (a log line or table): marker search must stay linear.",
      "file": "dash-flood.txt",
      "passphrase": null,
      "maxMillis": 2000,
      "expect": {
        "error": "NOT_FOUND"
      }
    },
    {
      "name": "not-a-zip",
