    {
      "name": "two-envelopes",
      "description": "Two envelopes in one text: the first one wins.",
      "file": "two-envelopes.txt",
      "passphrase": null,
      "expect": {
        "files": [
          {
            "path": "hello/hello.txt",
            "content": "SGVsbG8sIHdvcmxkIQo=",
